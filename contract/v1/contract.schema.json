{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwcdq.local/contract/v1/contract.schema.json",
  "title": "HWCDQ language-neutral contract document",
  "description": "Documentary schema for files in contract/v1. tools/validate_contract.py performs the normative cross-file and semantic checks; it does not claim to be a general JSON Schema validator.",
  "type": "object",
  "required": [
    "schema_version",
    "contract_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(docs|evidence)/.+"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "lowercaseHex": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})*$"
    },
    "confidence": {
      "enum": [
        "confirmed",
        "high_confidence",
        "tentative",
        "unknown"
      ]
    },
    "f32Value": {
      "type": "object",
      "required": [
        "decimal",
        "f32le_hex"
      ],
      "properties": {
        "decimal": {
          "type": "string"
        },
        "f32le_hex": {
          "$ref": "#/$defs/lowercaseHex"
        }
      },
      "additionalProperties": false
    },
    "evidenceBacked": {
      "type": "object",
      "required": [
        "confidence",
        "evidence"
      ],
      "properties": {
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
