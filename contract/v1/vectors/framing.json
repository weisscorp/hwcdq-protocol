      "post_error_chunks_hex": ["020606"],
      "post_error_frames_hex": ["020606"]
    },
    {
      "id": "invalid_length_one_fails_closed",
      "chunks_hex": ["01"],
      "expected_frames_hex": [],
      "expected_buffered_bytes": 0,
      "expected_code": "stream.length.invalid"
    },
    {
      "id": "frame_exceeds_configured_maximum",
      "maximum_frame_size": 20,
      "chunks_hex": ["23"],
      "expected_frames_hex": [],
      "expected_buffered_bytes": 0,
      "expected_code": "stream.length.invalid"
    },
    {
      "id": "checksum_failure_discards_following_coalesced_frame",
      "chunks_hex": ["020405020606"],
