        "230244343144384344393846303042323034453938",
        "303039393845434638343237450045"
      ],
      "expected_frames_hex": ["230244343144384344393846303042323034453938303039393845434638343237450045"],
      "expected_buffered_bytes": 0
    },
    {
      "id": "coalesced_three_frames",
      "chunks_hex": ["020101020505020606"],
      "expected_frames_hex": ["020101", "020505", "020606"],
